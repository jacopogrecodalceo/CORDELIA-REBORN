// ─── WHITESPACE ──────────────────────────────────────────────────────────────
%import common.NEWLINE
%ignore /[ \t\r]+/

// ─── ENTRY ───────────────────────────────────────────────────────────────────
program: _NL* (unit _NL*)*

_NL: NEWLINE

// ─── UNIT ────────────────────────────────────────────────────────────────────
unit: phrase
	| statement

// ─── STATEMENT ───────────────────────────────────────────────────────────────
// header + score + closing delimiter
statement: header score_line delim

// ─── PHRASE ──────────────────────────────────────────────────────────────────
// header + modifiers + score segments separated/closed by delimiters
phrase: header modifier* DELIM score_line (delim score_line)*
      | header modifier* (_NL modifier+)* delim score_line (delim score_line)*

delim: DELIM | _NL

// ─── HEADER ──────────────────────────────────────────────────────────────────
header: "@" IDENTIFIER

// ─── MODIFIERS ───────────────────────────────────────────────────────────────
modifier: dot_mod
        | colon_mod

dot_mod:   "." IDENTIFIER call?
colon_mod: ":" IDENTIFIER call?

// ─── CALL ────────────────────────────────────────────────────────────────────
call: "(" [arg_list] ")"

arg_list: arg ("," arg)*

arg: IDENTIFIER
   | NUMBER
   | STRING

// ─── DELIMITER ───────────────────────────────────────────────────────────────
DELIM: "·" | "|"

// ─── SCORE ───────────────────────────────────────────────────────────────────
score_line: score_atom+

score_atom: IDENTIFIER
           | NUMBER
           | SYMBOL
           | LBRACE
           | RBRACE
           | ","

// ─── TOKENS ──────────────────────────────────────────────────────────────────
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_#]*/
NUMBER:     /-?\d+(\.\d+)?/
STRING:     /"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/
LBRACE:     "{"
RBRACE:     "}"
SYMBOL:     /[#b]/

COMMENT: ";" /[^\n]*/
%ignore COMMENT