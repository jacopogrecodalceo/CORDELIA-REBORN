%import common.NEWLINE
%import common.WS_INLINE

%ignore /;[^\n]*/
%ignore /;@[\s\S]*?$/

// ─────────────────────────────────────────────
// TOKENS
// ─────────────────────────────────────────────

NAME:   /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /-?\d+\/\d+|-?\d*\.\d+|-?\d+/
NOTE:   /[a-g](?:\.+|'+)?/
REPEAT: /x\d+/

_NL:    NEWLINE
_DELIM: "·" | "|"
_SEP: WS_INLINE

SYM: /\+|\-|\*|\/|<|>|=|\?|\./

// ─── HEADER ──────────────────────────────────────────────────────────────────
header: "@" NAME ("#" NUMBER)?

// ─── ENTRY ───────────────────────────────────────────────────────────────────

?unit: phrase | statement

// ─── STATEMENT ───────────────────────────────────────────────────────────────

statement: header _SEP expr (_SEP expr)*

// ─── PHRASE ──────────────────────────────────────────────────────────────────

phrase:  header modifier* _SEP* score
score: ((_DELIM | _NL) _SEP* quality _SEP*)+
quality: _SEP* expr (_SEP expr)*
// ─────────────────────────────────────────────
// MODIFIERS
// ─────────────────────────────────────────────

modifier: _NL* (serial | parallel)

serial:   "." NAME array? ("{}"|"()")?
parallel: ":" NAME array? ("{}"|"()")?

// ─────────────────────────────────────────────
// STRUCTURES
// ─────────────────────────────────────────────

array: "(" _SEP* expr (_SEP+ expr)* _SEP* ")"
     | "{" _SEP* expr (_SEP+ expr)* _SEP* "}"

func: NAME array

// ─────────────────────────────────────────────
// EXPRESSION SYSTEM (THIS IS THE KEY FIX)
// ─────────────────────────────────────────────

?expr: term (SYM term)*

?term: func
     | array
     | NUMBER REPEAT -> repeat
     | NOTE
     | NUMBER
     | NAME