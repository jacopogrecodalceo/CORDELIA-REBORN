
	instr {{ name }}
	$CORDELIA_QUALITIEs
	$CORDELIA_RELEASE
	$CORDELIA_ENV(
		ienv init .005
		aenv cossegr 0, ienv, 1, idur-(ienv*2), 1, ienv, 0
	)


idur			divz idur, i(gk{{ name }}_dur), 1

ioff			i gk{{ name }}_off

isonvs		i gk{{ name }}_sonvs
isonvs		abs isonvs

isonvs		init isonvs%(gi{{ name }}_len-1)
imod			init gi{{ name }}_channels-1

index			init (isonvs*gi{{ name }}_channels)+imod

ift_sonvs	init gi{{ name }}_list[index]
itab_dur		init ftlen(ift_sonvs)/gi{{ name }}_sr

irange		i chnget("heart") / 512
aphase		phasor (1/itab_dur)+irange+jitter(1/512, 1/idur, 4/idur)
aphase		+= (i(gkBEATn)/icps)
aphase		+= ioff
aout			table3 aphase % 1 , ift_sonvs, 1

aout			*= idyn

	$CORDELIA_OUT
	endin

