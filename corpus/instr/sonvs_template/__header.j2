
gi{{ instrument.identity.name }}_sr			init {{ data.sr }}
gi{{ instrument.identity.name }}_channels	init {{ data.channels }}

{% for ch in range(1, data.channels + 1) %}
gi{{ instrument.identity.name }}_{{ ch }}		ftgen 0, 0, 0, 1, "{{ data.path }}", 0, 0, {{ ch }}
{% endfor %}

gi{{ instrument.identity.name }}_list[]		fillarray {% for ch in range(1, data.channels + 1) %}gi{{ instrument.identity.name }}_{{ ch }}{% if not loop.last %}, {% endif %}{% endfor %}

gi{{ instrument.identity.name }}_len			init lenarray(gi{{ instrument.identity.name }}_list)/gi{{ instrument.identity.name }}_channels
gi{{ instrument.identity.name }}_where			init 0
gk{{ instrument.identity.name }}_off			init 0
gk{{ instrument.identity.name }}_dur			init 1
gk{{ instrument.identity.name }}_sonvs			init 1
