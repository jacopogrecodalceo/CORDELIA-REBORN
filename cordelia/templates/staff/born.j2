; ── Staff {{ staff.instr_id }} BORN ────────────────────────────
gk{{ staff.instr_id }}_dur init {{ staff.staff_dur }}

gi{{ staff.instr_id }}_talea ftgen {{ staff.talea_ft_num }}, 0, {{ ftgen_size }}, -2, {{ staff.talea | length }}, {{ staff.talea | join(', ') }}

{% for p in params if p != 'talea' %}
gi{{ staff.instr_id }}_{{ p }} ftgen {{ param_data[p].ft_num }}, 0, {{ ftgen_size }}, -2, {{ param_data[p].values | length }}, {{ param_data[p].values | join(', ') }}
{% endfor %}

{% for p in params if p != 'talea' %}
gk{{ staff.instr_id }}_{{ p }}_count init -1
{% endfor %}

instr {{ staff.instr_id }}
	ktalea_last init -1
	kinit_flag  init 1

	kmain   chnget "main_phase"
	kphase  = (kmain * gk{{ staff.instr_id }}_dur) % 1
	ktalea_len = {{ staff.talea | length }}
	ktalea_idx = int(kphase * ktalea_len) + 1
	ktalea  table ktalea_idx, gi{{ staff.instr_id }}_talea

	if ktalea > 0 && ktalea != ktalea_last then
		if kinit_flag == 1 then
			{% for p in params if p != 'talea' %}
			gk{{ staff.instr_id }}_{{ p }}_count = ktalea - 1
			{% endfor %}
			kinit_flag = 0
		endif

		{% for p in params if p != 'talea' %}
		k{{ p }}_len  table 0, gi{{ staff.instr_id }}_{{ p }}
		k{{ p }}_idx  = (gk{{ staff.instr_id }}_{{ p }}_count % k{{ p }}_len) + 1
		k{{ p }}      table k{{ p }}_idx, gi{{ staff.instr_id }}_{{ p }}
		{% endfor %}

		; ── schedule events ──────────────────────────────────────
		if kspace == 0 then
			kch = 1
			until kch > nchnls do
				schedulek "{{ staff.instrument }}", 0, kdur * gkbeats * gk{{ staff.instr_id }}_dur / gkdiv, kdyn, kenv, kcolores, kch
				kch += 1
			od
		else
			schedulek "{{ staff.instrument }}", 0, kdur * gkbeats * gk{{ staff.instr_id }}_dur / gkdiv, kdyn, kenv, kcolores, kspace
		endif

		{% for p in params if p != 'talea' %}
		gk{{ staff.instr_id }}_{{ p }}_count += 1
		{% endfor %}
		ktalea_last = ktalea
	endif
endin

schedule "{{ staff.instr_id }}", ksmps/sr, -1