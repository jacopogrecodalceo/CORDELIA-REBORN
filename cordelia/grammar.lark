%import common.NEWLINE
%import common.WS_INLINE

// ─────────────────────────────────────────────
// TOKENS
// ─────────────────────────────────────────────

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /-?\d+\/\d+|-?\d*\.\d+|-?\d+/

// SPECIAL CHAR
NOTE: /[a-g](?:\.+|'+)?/
ALEA: /\d+\?/
DEGREE: /\d+(M|m|d|a)/
REPEAT: /x\d+|\d+x\d+/

_NL:    NEWLINE
_DELIM: "·" | "|"
_SEP: WS_INLINE

SYM: /\+|\-|\*|\/|<|>|=|\./

// ─── HEADER ──────────────────────────────────────────────────────────────────
header: "@" NAME ("#" NUMBER)?

// ─── ENTRY ───────────────────────────────────────────────────────────────────

?unit: phrase | statement

// ─── STATEMENT ───────────────────────────────────────────────────────────────

statement: header _SEP term (SYM term)* (_SEP term (SYM term)*)*

// ─── PHRASE ──────────────────────────────────────────────────────────────────

phrase:  header modifier* _SEP* score
score: ((_DELIM | _NL) _SEP* quality _SEP*)+
quality: _SEP* term (SYM term)* (_SEP term (SYM term)*)*
// ─────────────────────────────────────────────
// MODIFIERS
// ─────────────────────────────────────────────

modifier: _NL* (serial | parallel)

serial:   "." NAME array? ("{}"|"()")?
parallel: ":" NAME array? ("{}"|"()")?

// ─────────────────────────────────────────────
// STRUCTURES
// ─────────────────────────────────────────────

array: "(" _SEP* term (SYM term)* (_SEP+ term (SYM term)*)* _SEP* ")"
     | "{" _SEP* term (SYM term)* (_SEP+ term (SYM term)*)* _SEP* "}"

func: NAME array

// ─────────────────────────────────────────────
// term (SYM term)*ESSION SYSTEM (THIS IS THE KEY FIX)
// ─────────────────────────────────────────────

?term: func
     | array
     | NOTE
     | NUMBER
     | NAME
     | ALEA
     | REPEAT
     | DEGREE
