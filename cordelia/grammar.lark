%import common.NEWLINE
%import common.WS_INLINE

// ─────────────────────────────────────────────
// TOKENs
// ─────────────────────────────────────────────

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /-?\d+\/\d+|-?\d*\.\d+|-?\d+/

// SPECIAL CHAR
NOTE: /[a-g](is|es)?(s|f)?(?:\.+|'+)?/
ALEA: /\d+\?/
DEGREE: /\d+(M|m|d|a)/
REPEAT: /\^\d+/

_NL:    NEWLINE
_DELIM: "·" | "|"
_SPACE: WS_INLINE

SYM: /\+|\-|\*|\/|<|>|=|\./

MODIFIER_KIND: "."|":"

?voice_id: ("#" NUMBER)

header: "@" NAME voice_id? 

?node: instrument | variable

// ─────────────────────────────────────────────
// MAIN ENTRIEs
// ─────────────────────────────────────────────

variable: header _SPACE verse+

instrument:  header modifier* ((_DELIM | _NL) verse)+

// ─────────────────────────────────────────────
// verse
// ─────────────────────────────────────────────

verse: item (_SPACE item)*

// ─────────────────────────────────────────────
// modifier are modifiers aka FXs
// ─────────────────────────────────────────────

modifier: _NL* MODIFIER_KIND NAME array? ("{}"|"()")?

// ─────────────────────────────────────────────
// STRUCTURES
// ─────────────────────────────────────────────

array: "(" _SPACE* item (_SPACE+ item)* _SPACE* ")"
		| "{" _SPACE* item (_SPACE+ item)* _SPACE* "}"

func: NAME array

repeat: syllabe REPEAT*

expr: syllabe (SYM syllabe)*

// ─────────────────────────────────────────────
// ITEM
// ─────────────────────────────────────────────

?item: syllabe | repeat | expr


?syllabe: func
			| array
			| NOTE
			| NUMBER
			| NAME
			| ALEA
			| DEGREE
