%import common.NEWLINE
%import common.WS_INLINE

// ─────────────────────────────────────────────
// TOKENs
// ─────────────────────────────────────────────

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /-?\d+\/\d+|-?\d*\.\d+|-?\d+/

// SPECIAL CHAR
NOTE: /[a-g](is|es)?(?:\.+|'+)?/
ALEA: /\d+\?/
DEGREE: /\d+(M|m|d|a)/
REPEAT: /\^\d+/

_NL:    NEWLINE
_DELIM: "·" | "|"
_SPACE: WS_INLINE

SYM: /\+|\-|\*|\/|<|>|=|\./

INVOCATION_KIND: "."|":"

cordelia_id: ("#" NUMBER)

epigraph: "@" NAME

?poem: phrase | statement

// ─────────────────────────────────────────────
// MAIN ENTRIEs
// ─────────────────────────────────────────────

statement: epigraph _SPACE verse+

phrase:  epigraph cordelia_id? invocation* ((_DELIM | _NL) verse)+

// ─────────────────────────────────────────────
// VERSE
// ─────────────────────────────────────────────

verse: foot (_SPACE foot)*

// ─────────────────────────────────────────────
// invocation are modifiers aka FXs
// ─────────────────────────────────────────────

invocation: _NL* INVOCATION_KIND NAME array? ("{}"|"()")?

// ─────────────────────────────────────────────
// STRUCTURES
// ─────────────────────────────────────────────

array: "(" _SPACE* foot (_SPACE+ foot)* _SPACE* ")"
		| "{" _SPACE* foot (_SPACE+ foot)* _SPACE* "}"

func: NAME array

// ─────────────────────────────────────────────
// FEET
// ─────────────────────────────────────────────

foot: repeat (SYM repeat)*

?repeat: syllabe REPEAT*

?syllabe: func
			| array
			| NOTE
			| NUMBER
			| NAME
			| ALEA
			| DEGREE
