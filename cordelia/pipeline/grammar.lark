// ─── WHITESPACE ──────────────────────────────────────────────────────────────
%import common.NEWLINE
%ignore /[ \t\r]+/

// ─── ENTRY ───────────────────────────────────────────────────────────────────
program: _NL* (unit _NL*)*

_NL: NEWLINE

// ─── UNIT ────────────────────────────────────────────────────────────────────
unit: phrase | statement

// ─── STATEMENT ───────────────────────────────────────────────────────────────
// header + score + closing delimiter
statement: header score (_DELIM | _NL)

// ─── PHRASE ──────────────────────────────────────────────────────────────────
// header + modifiers + score segments separated/closed by delimiters
phrase: header modifier* _DELIM score ((_DELIM | _NL) score)*
		| header modifier* (_NL modifier+)* (_DELIM | _NL) score ((_DELIM | _NL) score)*

// ─── HEADER ──────────────────────────────────────────────────────────────────
header: "@" IDENTIFIER

// ─── MODIFIERS ───────────────────────────────────────────────────────────────
modifier: dot_mod
	  | colon_mod

dot_mod:   "." IDENTIFIER call?
colon_mod: ":" IDENTIFIER call?

// ─── CALL ────────────────────────────────────────────────────────────────────
call: "(" [arg_list] ")"

arg_list: arg ("," arg)*

arg: IDENTIFIER
   | NUMBER
   | STRING

// ─── DELIMITER ───────────────────────────────────────────────────────────────
_DELIM: "·" | "|"

// ─── SCORE ───────────────────────────────────────────────────────────────────
score: score_atom+

score_atom: IDENTIFIER
				| NUMBER
				| SYMBOL
				| LBRACE
				| RBRACE
				| ","

// ─── TOKENS ──────────────────────────────────────────────────────────────────
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_#]*/
NUMBER:     /-?\d+(\.\d+)?/
STRING:     /"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/
LBRACE:     "{"
RBRACE:     "}"
SYMBOL:     /[#b]/

COMMENT: ";" /[^\n]*/
%ignore COMMENT